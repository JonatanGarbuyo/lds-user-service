# Copy to .env for local development. Never commit .env or production secrets.

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
DB_CONNECT_TIMEOUT=5s
DB_MAX_CONNS=10

POSTGRES_DB=lds_user_service
POSTGRES_USER=lds
POSTGRES_PASSWORD=lds_dev_password
POSTGRES_PORT=5432

# Development email adapter. The verification code is written here, never logged.
MAIL_OUTBOX_FILE=/tmp/lds-user-service-mail/outbox.jsonl

# Login policy. Defaults to requiring a verified email.
EMAIL_VERIFICATION_REQUIRED=true

# Opaque web session cookie and lifetime (30 days idle, 90 days absolute).
SESSION_COOKIE_NAME=lds_session
SESSION_IDLE_TTL=720h
SESSION_ABSOLUTE_TTL=2160h

# Exact browser origins allowed to call the service with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:4321

# Reader State JWT (UX only). In development an ephemeral ES256 key is generated
# when no key is configured; configure READER_STATE_PRIVATE_KEY_FILE elsewhere.
READER_STATE_ISSUER=lds-user-service
READER_STATE_AUDIENCE=lds-web
READER_STATE_TTL=30m
# READER_STATE_PRIVATE_KEY_FILE=/run/secrets/reader-state.pem
# READER_STATE_PREVIOUS_PUBLIC_KEYS_FILE=/run/secrets/reader-state-previous.pem

# Used when running Go commands against the Compose PostgreSQL instance from the host.
DATABASE_URL=postgres://lds:lds_dev_password@localhost:5432/lds_user_service?sslmode=disable
