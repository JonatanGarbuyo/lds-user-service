# Copy to .env for local development. Never commit .env or production secrets.

APP_ENV=development
HTTP_PORT=8080
LOG_LEVEL=info
SHUTDOWN_TIMEOUT=10s
DB_CONNECT_TIMEOUT=5s
DB_MAX_CONNS=10

POSTGRES_DB=lds_user_service
POSTGRES_USER=lds
POSTGRES_PASSWORD=lds_dev_password
POSTGRES_PORT=5432

# Development email adapter. The verification code is written here, never logged.
MAIL_OUTBOX_FILE=/tmp/lds-user-service-mail/outbox.jsonl

# Consumed by login in T03. Defaults to requiring a verified email.
EMAIL_VERIFICATION_REQUIRED=true

# Used when running Go commands against the Compose PostgreSQL instance from the host.
DATABASE_URL=postgres://lds:lds_dev_password@localhost:5432/lds_user_service?sslmode=disable
